---
import FieldButton from "@/components/FieldButton.astro";
import Base from "@/layouts/Base.astro";
import { pageColumn, url } from "@/site";
---

<Base title="Page not found | FiscalCR" description="The page you were looking for isn't on this site." noindex>
  <section class="on-field">
    <div class:list={[pageColumn, "flex min-h-[60svh] flex-col justify-center py-24"]}>
      <p class="text-txt-on-field text-label-md font-semibold">404</p>
      <h1 class="mt-3 text-[clamp(2.5rem,1.5rem+3vw,4rem)] leading-tight font-semibold tracking-[-0.035em]">This page isn't here</h1>
      <p class="text-txt-on-field text-body-lg mt-4 max-w-[36rem]">It may have moved, or the address has a typo.</p>
      <div class="mt-8"><FieldButton href={url("/")}>Go to the home page</FieldButton></div>
    </div>
  </section>
</Base>
