---
/**
 * Copies the workflow file (the page's #workflow block, so its text is in the
 * page once) and says so, in place and to screen readers. White on the
 * primary field, or small and quiet in the corner of the code block.
 */
import Check from "@/components/ui/icons/check.astro";
import { fieldButton } from "@/site";

interface Props {
  label?: string;
  variant?: "field" | "code";
  class?: string;
}
const { label = "Copy workflow", variant = "field", class: className } = Astro.props;
---

<button
  type="button"
  data-copy-workflow
  class:list={[
    "group",
    variant === "field"
      ? fieldButton.solid
      : "focus-ring text-label-sm text-txt-white bg-bg-white/10 hover:bg-bg-white/20 inline-flex h-8 items-center gap-2 rounded-md px-3 font-medium transition-colors",
    className,
  ]}
>
  <svg class="size-4 shrink-0 group-data-done:hidden" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <rect x="6.75" y="6.75" width="9.5" height="9.5" rx="1.75" stroke="currentColor" stroke-width="1.5" />
    <path d="M13.25 4.5v-.25a1.5 1.5 0 0 0-1.5-1.5h-7a1.5 1.5 0 0 0-1.5 1.5v7a1.5 1.5 0 0 0 1.5 1.5H5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  </svg>
  <Check class="hidden size-4 shrink-0 group-data-done:block" aria-hidden="true" />
  <span class="group-data-done:hidden">{label}</span>
  <span class="hidden group-data-done:inline">Copied</span>
  <span class="sr-only" role="status" data-status></span>
</button>

<script>
  const source = () => document.querySelector("#workflow code")?.textContent ?? "";
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-workflow]")) {
    const status = button.querySelector<HTMLElement>("[data-status]")!;
    let timer = 0;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(source());
      } catch {
        // No clipboard (an insecure context or a refusal): take them to the file instead.
        document.querySelector("#workflow")?.scrollIntoView({ behavior: "smooth", block: "center" });
        status.textContent = "Couldn't copy. The workflow is shown in the Install section.";
        return;
      }
      button.dataset.done = "";
      status.textContent = "Workflow copied to the clipboard";
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete button.dataset.done;
        status.textContent = "";
      }, 2200);
    });
  }
</script>
