---
/** A "read more" link with an arrow: primary on white, white on the primary field. */
import ArrowForward from "@/components/ui/icons/arrow-forward.astro";

interface Props {
  href: string;
  onField?: boolean;
  class?: string;
}
const { href, onField = false, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    "text-label-lg focus-ring inline-flex items-center gap-1.5 rounded-xs font-medium underline decoration-1 underline-offset-[3px] hover:decoration-2",
    onField ? "text-txt-white" : "text-txt-primary",
    className,
  ]}
>
  <slot />
  <ArrowForward class="size-4" aria-hidden="true" />
</a>
