{
  "name": "fiscalcr-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FiscalCR's public landing page: a static Astro build on FTDS, deployed to GitHub Pages.",
  "scripts": {
    "llms": "pnpm --dir .. llms:sync --out site/public/llms.txt",
    "predev": "pnpm llms",
    "dev": "astro dev --port 4322",
    "prebuild": "pnpm llms",
    "build": "astro build",
    "preview": "astro preview --port 4322",
    "check-types": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@oddbird/popover-polyfill": "^0.7.3",
    "astro": "^7.4.4",
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  }
}
